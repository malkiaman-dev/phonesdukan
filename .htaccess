<IfModule mod_rewrite.c>
    RewriteEngine On
    Options -MultiViews
    DirectoryIndex index.php index.html

    # Force non-www to www on production domain only
    RewriteCond %{HTTP_HOST} ^phonesdukan\.com$ [NC]
    RewriteRule ^ https://www.phonesdukan.com%{REQUEST_URI} [L,R=301,NE]

    # Fix accidental admin-relative asset URLs like /admin/public/assets/...
    RewriteRule ^admin/public/(.*)$ public/$1 [L,NC]

    # Allow existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all other requests through index.php
    RewriteRule ^ index.php [L,QSA]
</IfModule>
